    // Google falou que ficaria mais fácil com uma variável 
let resposta = " ";

function verificar() {
    // Verifica se o usuário não escolheu nada
    if (resposta == " ") {
        alert("escolha uma opção primeiro");
    }
    // Corrigido: agora testamos a variável 'resposta'
    else if (resposta == "verdadeiro") {
        alert("parabéns!");
    }
    else {
        alert("resposta errada");
    }
}